				{
					"var.dis": "sqrt(pow(abs(player_pos_x-pos_x), 2)+pow(abs(player_pos_z-pos_z), 2)+pow(abs(player_pos_y-pos_y), 2))",
					"var.counter": "if(var.dis>1&&var.dis<3&&!is_ridden, lerp(0.15, var.counter, torad(-80)), lerp(0.15, var.counter, torad(0)))",
					"var.res": "if(var.dis<1, rot_y, 90)",
					"this.ry": "if(is_ridden&&var.dis<1, rot_y+player_rot_y, 90)",
					"left_door.rz": "var.counter",
					"right_door.rz": "-var.counter",
					"root.tz": "if(is_ridden, sin(10*frame_time)*0.5, 0)",
					"lawheel.rx": "if(move_forward!=0&&move_strafing!=0, -time/2, 0)",
					"lbwheel.rx": "if(move_forward!=0&&move_strafing!=0, -time/2, 0)",
					"rawheel.rx": "if(move_forward!=0&&move_strafing!=0, -time/2, 0)",
					"rbwheel.rx": "if(move_forward!=0&&move_strafing!=0, -time/2, 0)"
				}
