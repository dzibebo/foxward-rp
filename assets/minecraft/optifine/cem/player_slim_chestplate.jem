			"animations": [
				{
					"var.arm_len": "12",
					"var.link_base_len": "2",
					"var.wr_x": "-5 - var.arm_len * (cos(right_arm.rx)*sin(right_arm.rz) - sin(right_arm.rx)*sin(right_arm.ry)*cos(right_arm.rz))",
					"var.wr_y": "22 - var.arm_len * (cos(right_arm.rx)*cos(right_arm.rz) + sin(right_arm.rx)*sin(right_arm.ry)*sin(right_arm.rz))",
					"var.wr_z": " 0 + var.arm_len * sin(right_arm.rx)*cos(right_arm.ry)",
					"var.wl_x": " 5 + var.arm_len * (cos(left_arm.rx)*sin(left_arm.rz) - sin(left_arm.rx)*sin(left_arm.ry)*cos(left_arm.rz))",
					"var.wl_y": "22 - var.arm_len * (cos(left_arm.rx)*cos(left_arm.rz) + sin(left_arm.rx)*sin(left_arm.ry)*sin(left_arm.rz))",
					"var.wl_z": " 0 + var.arm_len * sin(left_arm.rx)*cos(left_arm.ry)",
					"var.dx": "var.wl_x - var.wr_x",
					"var.dy": "var.wl_y - var.wr_y",
					"var.dz": "var.wl_z - var.wr_z",
					"var.dist": "max(sqrt(var.dx*var.dx + var.dy*var.dy + var.dz*var.dz), 0.0001)",
					"var.stretch": "(var.dist / 2) / var.link_base_len",
					"center_point.tx": "var.wr_x + var.dx / 2",
					"center_point.ty": "var.wr_y + var.dy / 2-25",
					"center_point.tz": "var.wr_z + var.dz / 2-1.5",
					"center_point.rx": "asin(var.dz / var.dist)",
					"center_point.ry": "0",
					"center_point.rz": "atan2(-var.dx, var.dy)",
					"link_r.tx": "var.wr_x",
					"link_r.ty": "var.wr_y-25",
					"link_r.tz": "var.wr_z-1.5",
					"link_r.rx": "asin(var.dz / var.dist)",
					"link_r.ry": "0",
					"link_r.rz": "atan2(-var.dx, var.dy)",
					"link_r.sy": "var.stretch",
					"link_l.tx": "var.wl_x",
					"link_l.ty": "var.wl_y-25",
					"link_l.tz": "var.wl_z-1.5",
					"link_l.rx": "-asin(var.dz / var.dist)",
					"link_l.ry": "0",
					"link_l.rz": "atan2(var.dx, -var.dy)",
					"link_l.sy": "var.stretch"
				}
			]
		},
