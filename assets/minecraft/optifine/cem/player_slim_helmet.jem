			"animations": [
				{
					"trash.ty": "if(is_sneaking, -28, -32)",
					"trash.sy": "if(is_sneaking, 5, 1)",
					"bone.sy": "if(is_sneaking, 0.2, 1)",
					"bone2.sy": "if(is_sneaking, 0.2, 1)",
					"var.dt": "clamp(frame_time, 0.001, 0.05)",
					"var.target_lean": "clamp(-move_forward * torad(45), -torad(45), torad(45))",
					"var.lean_vel": "var.lean_vel + (var.target_lean - var.lean) * 250 * var.dt - var.lean_vel * 12 * var.dt",
					"var.lean": "var.lean + var.lean_vel * var.dt",
					"test.rx": "var.lean/2",
					"var.target_lean2": "clamp(move_strafing * torad(45), -torad(45), torad(45))",
					"var.lean_vel2": "var.lean_vel2 + (var.target_lean2 - var.lean2) * 250 * var.dt - var.lean_vel2 * 12 * var.dt",
					"var.lean2": "var.lean2 + var.lean_vel2 * var.dt",
					"test.rz": "var.lean2/2",
					"la.rz": "-var.lean2/5",
					"la.rx": "-var.lean/5",
					"ra.rz": "-var.lean2/5",
					"ra.rx": "-var.lean/5",
					"h.rz": "var.lean2/2",
					"h.rx": "var.lean/2",
					"b.rz": "var.lean2/5",
					"b.rx": "var.lean/5",
					"var.vel_y": "if(varb.initialized, (pos_y - var.prev_pos_y) / var.dt, 0)",
					"varb.jump_start": "varb.prev_on_ground && !is_on_ground && var.vel_y > 0.05",
					"varb.landed": "!varb.prev_on_ground && is_on_ground",
					"var.squash_vel": "var.squash_vel + (0 - var.squash) * 200 * var.dt - var.squash_vel * 10 * var.dt + if(varb.jump_start, 6, 0) - if(varb.landed, clamp(abs(var.vel_y) * 0.6, 1, 6), 0)",
					"var.squash": "var.squash + var.squash_vel * var.dt",
					"test.sy": "1 + var.squash",
					"var.prev_pos_y": "pos_y",
					"varb.prev_on_ground": "is_on_ground",
					"varb.initialized": "true"
				}
			]
		}
	]
